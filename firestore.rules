rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Teacher accounts are provisioned out-of-band. A client can never self-approve.
    function activeTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function ownsClass(classId) {
      return activeTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function validClass(data) {
      return data.keys().hasAll(['teacherId', 'name', 'section', 'yearLabel', 'active', 'createdAt'])
        && data.keys().hasOnly(['teacherId', 'name', 'section', 'yearLabel', 'active', 'createdAt'])
        && data.teacherId == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.section is string
        && data.section.size() <= 24
        && data.yearLabel is string
        && data.yearLabel.size() <= 40
        && data.active == true
        && data.createdAt == request.time;
    }

    function validStudent(data) {
      return data.keys().hasAll(['rollNo', 'displayName', 'active', 'createdAt'])
        && data.keys().hasOnly(['rollNo', 'displayName', 'active', 'createdAt'])
        && data.rollNo is string
        && data.rollNo.size() > 0
        && data.rollNo.size() <= 24
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.active == true
        && data.createdAt == request.time;
    }

    function validAttendance(data) {
      return data.keys().hasAll(['classId', 'dateISO', 'rollType', 'statuses', 'takenBy', 'updatedAt'])
        && data.keys().hasOnly(['classId', 'dateISO', 'rollType', 'statuses', 'takenBy', 'updatedAt'])
        && data.classId is string
        && data.dateISO is string
        && data.dateISO.size() == 10
        && data.rollType in ['MORNING', 'EVENING']
        && data.statuses is map
        && data.statuses.size() <= 100
        && data.takenBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validCalendarOverride(data, classId, dateISO) {
      return data.keys().hasAll(['classId', 'dateISO', 'kind', 'label', 'teacherId', 'updatedAt'])
        && data.keys().hasOnly(['classId', 'dateISO', 'kind', 'label', 'teacherId', 'updatedAt'])
        && data.classId == classId
        && data.dateISO is string
        && data.dateISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dateISO == dateISO
        && data.kind in ['HOLIDAY', 'WORKING']
        && data.label is string
        && data.label.size() > 0
        && data.label.size() <= 120
        && data.teacherId == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validAttendanceThreshold(data, classId) {
      return data.keys().hasAll(['classId', 'teacherId', 'termStartISO', 'termEndISO', 'trackingStartISO', 'workingWeekdays', 'sessionPolicy', 'leavePolicy', 'calendarConfirmed', 'updatedAt'])
        && data.keys().hasOnly(['classId', 'teacherId', 'termStartISO', 'termEndISO', 'trackingStartISO', 'workingWeekdays', 'sessionPolicy', 'leavePolicy', 'calendarConfirmed', 'updatedAt'])
        && data.classId == classId
        && data.teacherId == request.auth.uid
        && data.termStartISO is string
        && data.termStartISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.termEndISO is string
        && data.termEndISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.trackingStartISO is string
        && data.trackingStartISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.termStartISO <= data.trackingStartISO
        && data.trackingStartISO <= data.termEndISO
        && data.workingWeekdays is list
        && data.workingWeekdays.size() > 0
        && data.workingWeekdays.size() <= 7
        && data.workingWeekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && data.sessionPolicy in ['MORNING_ONLY', 'EVENING_ONLY', 'ANY_PRESENT', 'BOTH_PRESENT']
        && data.leavePolicy in ['COUNT_NOT_PRESENT', 'EXCLUDE_FULL_DAY']
        && data.calendarConfirmed == true
        && data.updatedAt == request.time;
    }

    match /teachers/{teacherId} {
      // Lets a signed-in teacher check only their own approval record.
      allow read: if signedIn() && request.auth.uid == teacherId;
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      allow get: if ownsClass(classId);
      // The equality-filtered list query in the client is restricted to the signed-in teacher.
      allow list: if activeTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if activeTeacher() && validClass(request.resource.data);
      // Class edits/archive are intentionally unavailable until a reviewed admin flow exists.
      allow update, delete: if false;

      match /students/{studentId} {
        allow read: if ownsClass(classId);
        allow create: if ownsClass(classId) && validStudent(request.resource.data);
        // Editing/deactivation needs a deliberate roster-maintenance flow.
        allow update, delete: if false;
      }

      // Attendance lives under its class so a teacher can safely check an empty
      // date/session document before the first roll has been saved.
      match /attendance/{attendanceId} {
        allow read: if ownsClass(classId);
        allow create: if ownsClass(classId)
          && validAttendance(request.resource.data)
          && request.resource.data.classId == classId
          && attendanceId == request.resource.data.dateISO + '_' + request.resource.data.rollType;
        allow update: if ownsClass(classId)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.dateISO == resource.data.dateISO
          && request.resource.data.rollType == resource.data.rollType
          && validAttendance(request.resource.data)
          && attendanceId == request.resource.data.dateISO + '_' + request.resource.data.rollType;
        allow delete: if false;
      }

      match /calendarOverrides/{dateISO} {
        allow read: if ownsClass(classId);
        allow create, update: if ownsClass(classId)
          && validCalendarOverride(request.resource.data, classId, dateISO);
        // Deleting an override restores the bundled Puducherry default for that date.
        allow delete: if ownsClass(classId);
      }

      match /attendanceSettings/{settingsId} {
        allow read: if ownsClass(classId);
        allow create, update: if ownsClass(classId)
          && settingsId == 'percentage'
          && validAttendanceThreshold(request.resource.data, classId);
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /attendance/{attendanceId} {
      allow read: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId)
        && validAttendance(request.resource.data);
      allow update: if ownsClass(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.dateISO == resource.data.dateISO
        && request.resource.data.rollType == resource.data.rollType
        && validAttendance(request.resource.data);
      allow delete: if false;
    }

    // Parent contact/consent records stay inaccessible until a separately reviewed
    // server-controlled workflow is implemented. This app has no send endpoint.
    match /parents/{parentId} {
      allow read, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
