rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Teacher accounts must be provisioned by an administrator; clients cannot self-approve.
    function activeTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function ownsClass(classId) {
      return activeTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    match /teachers/{teacherId} {
      allow read: if signedIn() && request.auth.uid == teacherId;
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if ownsClass(classId);
      allow create: if activeTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if ownsClass(classId)
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if false;

      match /students/{studentId} {
        allow read, create, update: if ownsClass(classId);
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /attendance/{attendanceId} {
      allow read: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId)
        && request.resource.data.takenBy == request.auth.uid
        && request.resource.data.rollType in ['MORNING', 'EVENING'];
      allow update: if ownsClass(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.takenBy == request.auth.uid
        && request.resource.data.rollType in ['MORNING', 'EVENING'];
      allow delete: if false;
    }

    match /parents/{parentId} {
      allow read: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId);
      allow update: if ownsClass(resource.data.classId)
        && request.resource.data.classId == resource.data.classId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
