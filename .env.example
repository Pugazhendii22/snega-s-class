# ── Firebase (her account must be the OWNER of this project — see docs/03 §2) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend ──
PORT=8080
NODE_ENV=development

# ── Messaging ──
# 🔴 THE PANIC SWITCH. "false" = nothing can ever leave the app. Default OFF.
MESSAGING_ENABLED=false

# dryrun | clicktosend | email | whatsapp_cloud | sms
MESSAGE_PROVIDER=dryrun

# silentpilot = full pipeline runs, every message rendered + logged, nothing sends
PILOT_MODE=silentpilot

# Stage 1 (WhatsApp Cloud API) — leave blank at Stage 0
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=

# Stage 2 (SMS) — ONLY after the college completes DLT registration. See docs/03 §1.1
SMS_PROVIDER_KEY=
SMS_SENDER_ID=

# Timezone — everything is computed in this zone, never server-local
TZ=Asia/Kolkata
