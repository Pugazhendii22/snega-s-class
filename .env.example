# Copy to .env.local for Vite local work. Keep demo mode enabled for synthetic data.
# Parent messaging has separate consent/review/pilot gates and remains disabled.
VITE_DEMO_MODE=true
DEMO_MODE=true

# Firebase (created and owned by the teacher; leave blank in demo mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local Node API
API_PORT=4101
NODE_ENV=development
TZ=Asia/Kolkata

# Safety switches: nothing is sent by this first build.
MESSAGING_ENABLED=false
MESSAGE_PROVIDER=dryrun
PILOT_MODE=silentpilot

# Reserved for a later approved WhatsApp Cloud API integration.
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
